# Public deployment
PAPERMARK_PUBLIC_URL=https://papermark.example.com
PAPERMARK_PUBLIC_HOST=papermark.example.com
APP_BASE_HOSTS=papermark.example.com,papermark-alt.example.com
PAPERMARK_STORAGE_ENDPOINT=https://papermark-storage.example.com
PAPERMARK_SOURCE_URL=https://github.com/example/papermark/commit/replace-me

# Authentication
NEXTAUTH_SECRET=
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD_HASH=

# PostgreSQL
POSTGRES_DB=papermark
POSTGRES_USER=papermark
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_PRISMA_URL_NON_POOLING=
POSTGRES_PRISMA_SHADOW_URL=

# Redis REST compatibility service
REDIS_PASSWORD=
SRH_TOKEN=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_REGION_NAME=us-east-1
MINIO_BUCKET=papermark
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Application secrets
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=
INTERNAL_API_KEY=
REVALIDATE_TOKEN=

# Optional email and queue integrations
RESEND_API_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
